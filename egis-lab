LAB_ROOT = ROOT / ".egis-lab"


def _manifest_for(root, role):
    files = {}
    for path in sorted(root.rglob("*")):
        if path.is_file() and path.name != "dataset-manifest.json":
            files[str(path.relative_to(root))] = {
                "sha256": sha256_file(path),
                "size": path.stat().st_size,
            }
    return {
        "schema_version": 1,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "source": "/var/lib/open-fprintd",
        "role": role,
        "files": files,
    }


def _chown_tree(root, uid, gid):
    for path in [root, *root.rglob("*")]:
        os.chown(path, uid, gid, follow_symlinks=False)


def _make_read_only(root):
    for path in root.rglob("*"):
        if path.is_dir():
            path.chmod(0o500)
        elif path.is_file():
            path.chmod(0o400)
    root.chmod(0o500)


def cmd_snapshot(args):
    if os.geteuid() != 0:
        raise SystemExit("Run once with: sudo ./egis-lab snapshot")
    target_user = os.environ.get("SUDO_USER")
    if not target_user or target_user == "root":
        raise SystemExit("SUDO_USER is unavailable; invoke through sudo as your normal user")
    account = pwd.getpwnam(target_user)
    source = Path("/var/lib/open-fprintd")
    for required in (source / "egis", source / "egis-calibration"):
        if not required.is_dir():
            raise SystemExit(f"required dataset directory is missing: {required}")

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    snapshot = LAB_ROOT / "snapshots" / stamp
    suffix = 0
    while snapshot.exists():
        suffix += 1
        snapshot = LAB_ROOT / "snapshots" / f"{stamp}-{suffix}"
    snapshot.mkdir(parents=True)
    shutil.copytree(source / "egis", snapshot / "egis")
    calibration_snapshot = snapshot / "egis-calibration"
    calibration_snapshot.mkdir()
    shutil.copytree(
        source / "egis-calibration" / "samples",
        calibration_snapshot / "samples",
    )
    for filename in ("report.json", "thresholds.json"):
        path = source / "egis-calibration" / filename
        if path.is_file():
            shutil.copy2(path, calibration_snapshot / filename)
    manifest = _manifest_for(snapshot, args.role)
    (snapshot / "dataset-manifest.json").write_text(
        json.dumps(manifest, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )

    current = LAB_ROOT / "current"
    if current.is_symlink() or current.exists():
        current.unlink()
    current.symlink_to(snapshot.relative_to(LAB_ROOT))
    _chown_tree(LAB_ROOT, account.pw_uid, account.pw_gid)
    _make_read_only(snapshot)
    LAB_ROOT.chmod(0o700)
    (LAB_ROOT / "snapshots").chmod(0o700)
    print(snapshot)


def cmd_holdout(args):
    if os.geteuid() != 0:
        raise SystemExit("Run once with: sudo ./egis-lab holdout")
    username = args.username or os.environ.get("SUDO_USER")
    if not username or username == "root":
        raise SystemExit("A non-root username is required")

    calibration_root = Path("/var/lib/open-fprintd/egis-calibration")
    sample_dir = calibration_root / "samples"
    archive_root = calibration_root / "archive"
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    archive_root.mkdir(mode=0o700, parents=True, exist_ok=True)
    if sample_dir.exists():
        os.replace(sample_dir, archive_root / stamp)
    sample_dir.mkdir(mode=0o700, parents=True, exist_ok=True)

    calibrate = ROOT / "open-fprintd-eh575" / "bin" / "egis-calibrate"
    env = {**os.environ, "PYTHONPATH": str(ROOT / "open-fprintd-eh575")}
    fingers = tuple(dict.fromkeys(args.fingers))
    matrix = tuple(
        (target, actual, "genuine" if target == actual else "impostor")
        for target in fingers for actual in fingers
    )
    print(f"Collecting {len(fingers)} genuine and {len(matrix) - len(fingers)} impostor pairs.", flush=True)
    subprocess.run(["systemctl", "stop", "egis-bridge"], check=True)
    try:
        for target, actual, label in matrix:
            subprocess.run(
                [
                    str(calibrate), "collect",
                    "--username", username,
                    "--target-finger", target,
                    "--actual-finger", actual,
                    "--label", label,
                    "--samples", str(args.samples),
                    "--frames", str(args.frames),
                ],
                check=True,
                env=env,
            )
    finally:
        subprocess.run(["systemctl", "start", "egis-bridge"], check=False)

    args.role = "holdout"
    cmd_snapshot(args)


def cmd_record_sequence(args):
    if os.geteuid() != 0:
        raise SystemExit("Run with: sudo ./egis-lab record-sequence --label LABEL")
    target_user = os.environ.get("SUDO_USER")
    if not target_user or target_user == "root":
        raise SystemExit("SUDO_USER is unavailable; invoke through sudo as your normal user")
    account = pwd.getpwnam(target_user)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    safe_label = "".join(
        character if character.isalnum() or character in "-_" else "_"
        for character in args.label
    ).strip("_") or "unlabeled"
    destination = LAB_ROOT / "sequences" / f"{stamp}-{safe_label}"
    commit = subprocess.check_output(
        ["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
    subprocess.run(["systemctl", "stop", "egis-bridge"], check=True)
    recorder = None
    pump = None
    try:
        driver = EgisDriver()
        recorder = SequenceRecorder(destination, metadata={
            "role": args.role,
            "label": args.label,
            "finger": args.finger,
            "source_commit": commit,
            "sensor_profile": driver.profile.name,
        }).start()
        print(
            f"Recording {args.role} sequence '{args.label}' "
            f"(up to {args.max_seconds:.1f}s).",
            flush=True,
        )
        print("Waiting for contact...", flush=True)
        initial = None
        wait_started = time.monotonic()
        while initial is None:
            frame, contrast, present = driver.capture_presence_frame()
            if present:
                initial = frame, contrast
                print(
                    f"Contact detected (contrast={contrast:.1f}); "
                    "move your finger across the sensor.",
                    flush=True,
                )
            elif time.monotonic() - wait_started >= 1.0:
                print("Still waiting for contact...", flush=True)
                wait_started = time.monotonic()

        progress = {"valid": 0, "last_report": time.monotonic()}

        def observe(message):
            accepted = recorder.observe(message)
            now = time.monotonic()
            if message.status.value == "valid":
                progress["valid"] += 1
            if message.dropped_before:
                print(
                    f"Capture queue dropped {message.dropped_before} frame(s); "
                    "recording marked incomplete.",
                    flush=True,
                )
            if message.status.value == "contact_end":
                print(
                    f"Contact released; captured {progress['valid']} valid frame(s).",
                    flush=True,
                )
            elif (message.status.value == "valid" and
                  now - progress["last_report"] >= 0.5):
                print(
                    f"Capturing... {progress['valid']} valid frame(s)",
                    flush=True,
                )
                progress["last_report"] = now
            return accepted

        pump = CapturePump(
            driver,
            driver.frame_spec,
            generation=1,
            capture_epoch=1,
            initial_frame=initial[0],
            initial_contrast=initial[1],
            on_message=observe,
        ).start()
        pump.wait(timeout=args.max_seconds)
        pump.stop(mark_end=True)
        complete = pump.terminal_status.value == "contact_end"
        recorder.close(complete=complete)
        recorder = None
        _chown_tree(destination, account.pw_uid, account.pw_gid)
        print(
            f"Sequence saved: {destination} "
            f"({progress['valid']} valid frame(s), complete={complete})",
            flush=True,
        )
        return 0 if complete else 2
    finally:
        if pump is not None:
            pump.stop()
        if recorder is not None:
            recorder.abort()
            _chown_tree(destination, account.pw_uid, account.pw_gid)
        subprocess.run(["systemctl", "start", "egis-bridge"], check=False)


def cmd_analyze_sequence(args):
    source = Path(args.sequence).resolve()
    manifest, messages = load_sequence(source)
    valid = [message for message in messages if message.status.value == "valid"]
    if not valid:
        raise SystemExit("sequence contains no valid frames")
    spec = valid[0].frame_spec
    if any(message.frame_spec != spec for message in messages):
        raise SystemExit("sequence changes frame geometry")
    tracker = TouchTracker(spec)
    observations = []
    for message, boundary in sequence_events(messages):
        if boundary:
            tracker.discontinuity()
        if message.status.value != "valid":
            continue
        tracked = tracker.observe(message.pixels, sequence=message.sequence)
        registration = tracked.registration
        observations.append({
            "sequence": tracked.sequence,
            "quality": tracked.quality,
            "component": registration.component,
            "reference": registration.reference,
            "matches": registration.matches,
            "inliers": registration.inliers,
            "inlier_ratio": registration.inlier_ratio,
            "ridge_score": registration.ridge_score,
            "spatial_cells": registration.spatial_cells,
            "confidence": registration.confidence,
            "reason": registration.reason,
            "transform": registration.transform.tolist(),
        })

    output = Path(args.output or source / "analysis")
    output.mkdir(parents=True, mode=0o700, exist_ok=True)
    output.chmod(0o700)
    mosaics = {}
    for component, image in tracker.render_components().items():
        path = output / f"component-{component}.png"
        if not cv2.imwrite(str(path), image):
            raise SystemExit(f"failed to write {path}")
        path.chmod(0o600)
        mosaics[str(component)] = path.name
    report = {
        "schema_version": 1,
        "source": str(source),
        "source_complete": bool(manifest.get("complete")),
        "source_recorder_dropped": int(manifest.get("recorder_dropped", 0)),
        "frame_spec": {"width": spec.width, "height": spec.height,
                       "dtype": spec.dtype},
        "summary": tracker.summary(),
        "observations": observations,
        "mosaics": mosaics,
    }
    report_path = output / "report.json"
    report_path.write_text(
        json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    report_path.chmod(0o600)
    print(report_path)
    return 0


def _private_lab_path(value):
    path = Path(value).resolve()
    if not path.is_relative_to(LAB_ROOT.resolve()) or path == LAB_ROOT.resolve():
        raise ValueError("atlas artifacts and reports must stay under .egis-lab")
    LAB_ROOT.mkdir(mode=0o700, exist_ok=True)
    LAB_ROOT.chmod(0o700)
    return path


def cmd_enroll_sequences(args):
    output = _private_lab_path(args.output)
    atlas, sources = enroll_sequences(args.sequences, finger=args.finger)
    manifest = save_atlas(atlas, output, sources, finger=args.finger)
    print(json.dumps(manifest["summary"], indent=2, sort_keys=True))
    print(output)


def cmd_match_sequence(args):
    atlas, atlas_manifest = load_atlas(args.atlas)
    report = evaluate_sequence(atlas, atlas_manifest, args.sequence, args.expected)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    output = _private_lab_path(
        args.output or LAB_ROOT / "results" / f"sequence-{stamp}.json")
    output.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    write_private_json(output, report)
    print("Experimental spatial evidence; not a calibrated authentication result.")
    print(json.dumps({key: report[key] for key in (
        "candidate_match", "candidate_correct", "time_to_evidence_capture_ms",
        "processing_p95_ms", "source_complete", "atlas_finger", "probe_finger")},
        indent=2, sort_keys=True))
    print(output)


def _resolve_dataset(value):
    path = Path(value) if value else LAB_ROOT / "current"
    path = path.resolve()
    if not (path / "dataset-manifest.json").is_file():
        raise SystemExit(f"dataset manifest not found under {path}")
    return path


def cmd_evaluate(args):
    dataset = _resolve_dataset(args.dataset)
    report = evaluate(
        dataset,
        args.config,
        ROOT,
        repeats=args.repeats,
    )
    output_dir = Path(args.output_dir or LAB_ROOT / "results")
    json_path, markdown_path = write_report(report, output_dir)
    print(markdown_path.read_text(encoding="utf-8"), end="")
    print(f"JSON: {json_path}")
    print(f"Markdown: {markdown_path}")
    return 0 if report["gates"]["passed"] else 2


def _load_report(path):
    with open(path, encoding="utf-8") as stream:
        return json.load(stream)


def cmd_compare(args):
    baseline = _load_report(args.baseline)
    candidate = _load_report(args.candidate)
    baseline_p95 = float(baseline["latency"]["p95_ms"])
    candidate_p95 = float(candidate["latency"]["p95_ms"])
    regression = (
        (candidate_p95 / baseline_p95) - 1.0
        if baseline_p95 > 0 else 0.0
    )
    limit = float(candidate["config"]["acceptance"]["max_latency_regression"])
    baseline_eligible = bool(baseline.get("gates", {}).get("passed"))
    relative_latency_ok = not baseline_eligible or regression <= limit
    result = {
        "baseline": args.baseline,
        "candidate": args.candidate,
        "baseline_p95_ms": baseline_p95,
        "candidate_p95_ms": candidate_p95,
        "latency_regression": regression,
        "latency_regression_limit": limit,
        "baseline_eligible": baseline_eligible,
        "relative_latency_ok": relative_latency_ok,
        "candidate_passed": bool(candidate["gates"]["passed"]),
        "passed": bool(candidate["gates"]["passed"] and relative_latency_ok),
    }
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if result["passed"] else 2


def cmd_build(args):
    test = subprocess.run(
        [sys.executable, "-m", "unittest", "discover", "-s", "tests", "-q"],
        cwd=ROOT,
        env={**os.environ, "PYTHONPATH": str(ROOT / "open-fprintd-eh575")},
    )
    if test.returncode != 0:
        raise SystemExit("tests failed; candidate artifact was not built")
    artifact = build_candidate(
        ROOT,
        args.candidate,
        args.baseline,
        args.output_dir or ROOT / "dist",
    )
    print(artifact)


def cmd_compatibility_report(args):
    evaluation = _load_report(args.evaluation)
    lifecycle = _load_report(args.lifecycle)
    environment = doctor_report(check_services=not args.no_service_check)
    report = public_compatibility_report(evaluation, lifecycle, environment)
    output = Path(args.output or f"compatibility-{report['report_id']}.json")
    output.write_text(
        json.dumps(report, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    output.chmod(0o600)
    print(output)
    return 0 if report["passed"] else 2


def build_parser():
    parser = argparse.ArgumentParser("egis-lab")
    sub = parser.add_subparsers(dest="command", required=True)

    snapshot = sub.add_parser("snapshot", help="Create a private immutable live-data snapshot")
    snapshot.add_argument(
        "--role",
        choices=("development", "holdout"),
        default="development",
    )
    snapshot.set_defaults(func=cmd_snapshot)

    holdout = sub.add_parser(
        "holdout",
        help="Collect the fixed physical holdout matrix and snapshot it",
    )
    holdout.add_argument("--username")
    holdout.add_argument(
        "--fingers", nargs="+",
        choices=("right-index-finger", "left-index-finger",
                 "right-thumb", "left-thumb"),
        default=("right-index-finger", "left-index-finger",
                 "right-thumb", "left-thumb"),
        help="Fingers used for the genuine/impostor matrix",
    )
    holdout.add_argument("--samples", type=int, default=8)
    holdout.add_argument("--frames", type=int, default=9)
    holdout.set_defaults(func=cmd_holdout)

    record = sub.add_parser(
        "record-sequence",
        help="Privately record one ordered touch sequence",
    )
    record.add_argument("--label", required=True)
    record.add_argument(
        "--finger", required=True,
        choices=("right-index-finger", "left-index-finger",
                 "right-thumb", "left-thumb"),
    )
    record.add_argument(
        "--role",
        choices=("enrollment", "development", "holdout"),
        default="development",
    )
    record.add_argument("--max-seconds", type=float, default=8.0)
    record.set_defaults(func=cmd_record_sequence)

    analyze = sub.add_parser(
        "analyze-sequence",
        help="Register and mosaic a private recorded sequence",
    )
    analyze.add_argument("sequence")
    analyze.add_argument("--output")
    analyze.set_defaults(func=cmd_analyze_sequence)

    enroll_sequence = sub.add_parser(
        "enroll-sequences", help="Build a private experimental atlas from enrollment touches")
    enroll_sequence.add_argument("sequences", nargs="+")
    enroll_sequence.add_argument(
        "--finger", required=True,
        choices=("right-index-finger", "left-index-finger",
                 "right-thumb", "left-thumb"),
    )
    enroll_sequence.add_argument("--output", required=True)
    enroll_sequence.set_defaults(func=cmd_enroll_sequences)

    match_sequence = sub.add_parser(
        "match-sequence", help="Replay spatial matching against an experimental atlas")
    match_sequence.add_argument("sequence")
    match_sequence.add_argument("--atlas", required=True)
    match_sequence.add_argument("--expected", choices=("genuine", "impostor"), required=True)
    match_sequence.add_argument("--output")
    match_sequence.set_defaults(func=cmd_match_sequence)

    evaluate_p = sub.add_parser("evaluate", help="Replay an offline dataset")
    evaluate_p.add_argument("--dataset", help="Snapshot root; defaults to .egis-lab/current")
    evaluate_p.add_argument("--config", default=str(ROOT / "lab-configs/baseline.json"))
    evaluate_p.add_argument("--output-dir")
    evaluate_p.add_argument("--repeats", type=int, default=2)
    evaluate_p.set_defaults(func=cmd_evaluate)

    compare = sub.add_parser("compare", help="Compare candidate and baseline reports")
    compare.add_argument("baseline")
    compare.add_argument("candidate")
    compare.set_defaults(func=cmd_compare)

    build = sub.add_parser("build", help="Build a checksummed passing candidate artifact")
    build.add_argument("--baseline", required=True)
    build.add_argument("--candidate", required=True)
    build.add_argument("--output-dir")
    build.set_defaults(func=cmd_build)

    compatibility = sub.add_parser(
        "compatibility-report",
        help="Export a sanitized aggregate report for external validation",
    )
    compatibility.add_argument("--evaluation", required=True)
    compatibility.add_argument("--lifecycle", required=True)
    compatibility.add_argument("--output")
    compatibility.add_argument("--no-service-check", action="store_true")
    compatibility.set_defaults(func=cmd_compatibility_report)
    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()
    try:
        return args.func(args) or 0
    except KeyboardInterrupt:
        return 130
    except (ValueError, FileExistsError) as error:
        parser.error(str(error))


if __name__ == "__main__":
    raise SystemExit(main())
