LAB_ROOT = ROOT / ".egis-lab"


def _manifest_for(root, role):
    files = {}
    for path in sorted(root.rglob("*")):
        if path.is_file() and path.name != "dataset-manifest.json":
            files[str(path.relative_to(root))] = {
                "sha256": sha256_file(path),
                "size": path.stat().st_size,
            }
    return {
        "schema_version": 1,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "source": "/var/lib/open-fprintd",
        "role": role,
        "files": files,
    }


def _chown_tree(root, uid, gid):
    for path in [root, *root.rglob("*")]:
        os.chown(path, uid, gid, follow_symlinks=False)


def _make_read_only(root):
    for path in root.rglob("*"):
        if path.is_dir():
            path.chmod(0o500)
        elif path.is_file():
            path.chmod(0o400)
    root.chmod(0o500)


def cmd_snapshot(args):
    if os.geteuid() != 0:
        raise SystemExit("Run once with: sudo ./egis-lab snapshot")
    target_user = os.environ.get("SUDO_USER")
    if not target_user or target_user == "root":
        raise SystemExit("SUDO_USER is unavailable; invoke through sudo as your normal user")
    account = pwd.getpwnam(target_user)
    source = Path("/var/lib/open-fprintd")
    for required in (source / "egis", source / "egis-calibration"):
        if not required.is_dir():
            raise SystemExit(f"required dataset directory is missing: {required}")

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    snapshot = LAB_ROOT / "snapshots" / stamp
    suffix = 0
    while snapshot.exists():
        suffix += 1
        snapshot = LAB_ROOT / "snapshots" / f"{stamp}-{suffix}"
    snapshot.mkdir(parents=True)
    shutil.copytree(source / "egis", snapshot / "egis")
    calibration_snapshot = snapshot / "egis-calibration"
    calibration_snapshot.mkdir()
    shutil.copytree(
        source / "egis-calibration" / "samples",
        calibration_snapshot / "samples",
    )
    for filename in ("report.json", "thresholds.json"):
        path = source / "egis-calibration" / filename
        if path.is_file():
            shutil.copy2(path, calibration_snapshot / filename)
    manifest = _manifest_for(snapshot, args.role)
    (snapshot / "dataset-manifest.json").write_text(
        json.dumps(manifest, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )

    current = LAB_ROOT / "current"
    if current.is_symlink() or current.exists():
        current.unlink()
    current.symlink_to(snapshot.relative_to(LAB_ROOT))
    _chown_tree(LAB_ROOT, account.pw_uid, account.pw_gid)
    _make_read_only(snapshot)
    LAB_ROOT.chmod(0o700)
    (LAB_ROOT / "snapshots").chmod(0o700)
    print(snapshot)


def cmd_holdout(args):
    if os.geteuid() != 0:
        raise SystemExit("Run once with: sudo ./egis-lab holdout")
    username = args.username or os.environ.get("SUDO_USER")
    if not username or username == "root":
        raise SystemExit("A non-root username is required")

    calibration_root = Path("/var/lib/open-fprintd/egis-calibration")
    sample_dir = calibration_root / "samples"
    archive_root = calibration_root / "archive"
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    archive_root.mkdir(mode=0o700, parents=True, exist_ok=True)
    if sample_dir.exists():
        os.replace(sample_dir, archive_root / stamp)
    sample_dir.mkdir(mode=0o700, parents=True, exist_ok=True)

    calibrate = ROOT / "open-fprintd-eh575" / "bin" / "egis-calibrate"
    env = {**os.environ, "PYTHONPATH": str(ROOT / "open-fprintd-eh575")}
    fingers = tuple(dict.fromkeys(args.fingers))
    matrix = tuple(
        (target, actual, "genuine" if target == actual else "impostor")
        for target in fingers for actual in fingers
    )
    print(f"Collecting {len(fingers)} genuine and {len(matrix) - len(fingers)} impostor pairs.", flush=True)
    subprocess.run(["systemctl", "stop", "egis-bridge"], check=True)
    try:
        for target, actual, label in matrix:
            subprocess.run(
                [
                    str(calibrate), "collect",
                    "--username", username,
                    "--target-finger", target,
                    "--actual-finger", actual,
                    "--label", label,
                    "--samples", str(args.samples),
                    "--frames", str(args.frames),
                ],
                check=True,
                env=env,
            )
    finally:
        subprocess.run(["systemctl", "start", "egis-bridge"], check=False)

    args.role = "holdout"
    cmd_snapshot(args)


def cmd_record_sequence(args):
    if os.geteuid() != 0:
        raise SystemExit("Run with: sudo ./egis-lab record-sequence --label LABEL")
    target_user = os.environ.get("SUDO_USER")
    if not target_user or target_user == "root":
        raise SystemExit("SUDO_USER is unavailable; invoke through sudo as your normal user")
    account = pwd.getpwnam(target_user)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    safe_label = "".join(
        character if character.isalnum() or character in "-_" else "_"
        for character in args.label
    ).strip("_") or "unlabeled"
    destination = LAB_ROOT / "sequences" / f"{stamp}-{safe_label}"
    commit = subprocess.check_output(
        ["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
    subprocess.run(["systemctl", "stop", "egis-bridge"], check=True)
    recorder = None
    pump = None
    driver = None
    try:
        driver = EgisDriver()
        recorder = SequenceRecorder(destination, metadata={
            "role": args.role,
            "label": args.label,
            "finger": args.finger,
            "source_commit": commit,
            "sensor_profile": driver.profile.name,
            **({"session_id": args.session_id,
                "attempt": args.attempt,
                "capture_order": args.capture_order}
               if hasattr(args, "session_id") else {}),
        }).start()
        print(
            f"Recording {args.role} sequence '{args.label}' "
            f"(up to {args.max_seconds:.1f}s).",
            flush=True,
        )
        print("Waiting for contact...", flush=True)
        initial = None
        wait_started = time.monotonic()
        while initial is None:
            frame, contrast, present = driver.capture_presence_frame()
            if present:
                initial = frame, contrast
                print(
                    f"Contact detected (contrast={contrast:.1f}); "
                    "move your finger across the sensor.",
                    flush=True,
                )
            elif time.monotonic() - wait_started >= 1.0:
                print("Still waiting for contact...", flush=True)
                wait_started = time.monotonic()

        progress = {"valid": 0, "last_report": time.monotonic()}

        def observe(message):
            accepted = recorder.observe(message)
            now = time.monotonic()
            if message.status.value == "valid":
                progress["valid"] += 1
            if message.dropped_before:
                print(
                    f"Capture queue dropped {message.dropped_before} frame(s); "
                    "recording marked incomplete.",
                    flush=True,
                )
            if message.status.value == "contact_end":
                print(
                    f"Contact released; captured {progress['valid']} valid frame(s).",
                    flush=True,
                )
            elif (message.status.value == "valid" and
                  now - progress["last_report"] >= 0.5):
                print(
                    f"Capturing... {progress['valid']} valid frame(s)",
                    flush=True,
                )
                progress["last_report"] = now
            return accepted

        pump = CapturePump(
            driver,
            driver.frame_spec,
            generation=1,
            capture_epoch=1,
            initial_frame=initial[0],
            initial_contrast=initial[1],
            on_message=observe,
        ).start()
        pump.wait(timeout=args.max_seconds)
        pump.stop(mark_end=True)
        complete = pump.terminal_status.value == "contact_end"
        recorder.close(complete=complete)
        recorder = None
        _chown_tree(destination, account.pw_uid, account.pw_gid)
        print(
            f"Sequence saved: {destination} "
            f"({progress['valid']} valid frame(s), complete={complete})",
            flush=True,
        )
        return 0 if complete else 2
    finally:
        if pump is not None:
            pump.stop()
        if recorder is not None:
            recorder.abort()
            _chown_tree(destination, account.pw_uid, account.pw_gid)
        if driver is not None:
            try:
                usb.util.dispose_resources(driver.dev)
            except Exception:
                pass
        subprocess.run(["systemctl", "start", "egis-bridge"], check=False)


FINGER_ORDER = (
    "right-index-finger", "left-index-finger",
    "right-thumb", "left-thumb",
)
ALL_FINGERS = FINGER_ORDER + ("right-pinky", "left-pinky")


def _latest_sequence(label):
    matches = sorted(
        (path for path in (LAB_ROOT / "sequences").glob(f"*-{label}")
         if path.is_dir() and (path / "manifest.json").is_file()),
        key=lambda path: path.stat().st_mtime,
    )
    return matches[-1] if matches else None


def _sequence_quality(path):
    manifest = json.loads((path / "manifest.json").read_text(encoding="utf-8"))
    events = manifest.get("events", [])
    valid = sum(event.get("status") == "valid" for event in events)
    clean = bool(
        manifest.get("complete") and
        not manifest.get("recorder_dropped", 0) and
        not any(event.get("status") == "io-error" for event in events)
    )
    return {"path": str(path), "valid_frames": valid, "clean": clean}


def cmd_capture_enrollment_session(args):
    session = args.session_id or datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    finger_order = tuple(getattr(args, "fingers", FINGER_ORDER))
    role = getattr(args, "role", "enrollment")
    max_captures = None if args.max_captures == 0 else args.max_captures
    if max_captures is not None and max_captures < args.min_captures:
        raise SystemExit("--max-captures must be at least --min-captures")
    print(
        f"Guided {role} session. Each touch is saved privately.", flush=True)
    print(f"Session ID: {session}", flush=True)
    for finger in finger_order:
        existing = []
        for path in sorted((LAB_ROOT / "sequences").glob(f"*-{session}-{finger}-{role}-*")):
            manifest_path = path / "manifest.json"
            if manifest_path.is_file():
                existing.append(_sequence_quality(path))
        accepted = [item for item in existing if item["clean"] and
                    item["valid_frames"] >= args.min_valid_frames]
        attempt = len(existing)
        if len(accepted) >= args.min_captures:
            print(f"{finger}: already has enough clean recordings; advancing.", flush=True)
            continue
        while max_captures is None or attempt < max_captures:
            attempt += 1
            label = f"{session}-{finger}-{role}-{attempt}"
            print("\n" + "=" * 68, flush=True)
            print(f"NEXT FINGER: {finger.upper()}", flush=True)
            print(f"Attempt {attempt}; place only that finger on the sensor.", flush=True)
            input("Press Enter when you have read this and are ready: ")
            record_args = argparse.Namespace(
                label=label, finger=finger, role=role,
                max_seconds=args.max_seconds,
                session_id=session,
                attempt=attempt,
                capture_order=finger_order.index(finger) + 1,
            )
            for retry in range(3):
                try:
                    result = cmd_record_sequence(record_args)
                    break
                except Exception as error:
                    if "Resource busy" not in str(error) or retry == 2:
                        raise
                    wait = 1.0 + retry
                    print(
                        f"Sensor is still busy; waiting {wait:.1f}s before retry "
                        f"({retry + 1}/3)...", flush=True)
                    time.sleep(wait)
            path = _latest_sequence(label)
            if path is None:
                raise SystemExit(f"recording did not produce a sequence: {label}")
            quality = _sequence_quality(path)
            if quality["clean"] and quality["valid_frames"] >= args.min_valid_frames:
                accepted.append(quality)
                print(
                    f"Accepted {finger}: {quality['valid_frames']} valid frame(s) "
                    f"({len(accepted)}/{args.min_captures} minimum).", flush=True)
            else:
                print(
                    f"Retained but not counted as clean: {quality['valid_frames']} "
                    "valid frame(s); repeat this finger.", flush=True)
            print(
                f"Lift your {finger.replace('-', ' ')} completely off the sensor.",
                flush=True)
            time.sleep(args.release_delay)
            input("Press Enter after your finger is lifted and you have seen the next prompt: ")
            stable = (
                len(accepted) >= args.min_captures and
                len(accepted) >= args.stable_captures and
                all(item["valid_frames"] >= args.min_valid_frames
                    for item in accepted[-args.stable_captures:])
            )
            if stable:
                print(f"{finger}: quality target reached; advancing.", flush=True)
                break
            if result not in (0, 2):
                raise SystemExit(f"recording failed for {label}")
        else:
            print(f"{finger}: capture limit reached; advancing.", flush=True)
        if len(accepted) < args.min_captures:
            print(
                f"WARNING: {finger} has only {len(accepted)} clean recording(s).",
                flush=True)
    print(f"\n{role.title()} session complete. Raw sequences retained privately.", flush=True)
    return 0


def cmd_prepare_enrollment_session(args):
    root = _private_lab_path(args.output)
    root.mkdir(parents=True, exist_ok=True)
    grouped = {finger: [] for finger in FINGER_ORDER}
    for path in sorted((LAB_ROOT / "sequences").glob("*")):
        manifest_path = path / "manifest.json"
        if not manifest_path.is_file():
            continue
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        metadata = manifest.get("metadata", {})
        if metadata.get("session_id") != args.session_id:
            continue
        finger = metadata.get("finger")
        if finger in grouped:
            grouped[finger].append((_sequence_quality(path), path))
    matrix = []
    atlases = {}
    for finger, entries in grouped.items():
        if len(entries) < 2:
            raise SystemExit(
                f"session {args.session_id} needs at least two recordings for {finger}")
        entries.sort(key=lambda item: item[1].name)
        probe = entries[-1][1]
        enrollment = [path for _, path in entries[:-1]]
        atlas, sources = enroll_sequences(enrollment, finger=finger)
        atlas_dir = root / finger
        save_atlas(atlas, atlas_dir, sources, finger=finger)
        atlases[finger] = str(atlas_dir)
        matrix.append({
            "target_finger": finger,
            "probe": str(probe),
            "expected": "genuine",
        })
        for other in FINGER_ORDER:
            if other == finger:
                continue
            other_entries = grouped[other]
            other_entries.sort(key=lambda item: item[1].name)
            matrix.append({
                "target_finger": finger,
                "probe": str(other_entries[-1][1]),
                "probe_finger": other,
                "expected": "impostor",
            })
    manifest = {
        "schema_version": 1,
        "session_id": args.session_id,
        "atlases": atlases,
        "replays": matrix,
    }
    output = root / "replay-matrix.json"
    output.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    output.chmod(0o600)
    print(output)
    return 0


def cmd_install_enrollment_session(args):
    if os.geteuid() != 0:
        raise SystemExit(
            "Run with: sudo ./egis-lab install-enrollment-session SESSION_ID")
    username = args.username or os.environ.get("SUDO_USER")
    if not username or username == "root":
        raise SystemExit("A non-root username is required")
    grouped = {finger: [] for finger in FINGER_ORDER}
    for path in sorted((LAB_ROOT / "sequences").glob("*")):
        manifest_path = path / "manifest.json"
        if not manifest_path.is_file():
            continue
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        metadata = manifest.get("metadata", {})
        finger = metadata.get("finger")
        if (metadata.get("session_id") != args.session_id or
                metadata.get("role") != "enrollment" or finger not in grouped):
            continue
        _, messages, _ = read_touch(
            path, require_complete=True, allow_timeout=True)
        frames = [message.pixels for message in messages
                  if message.status is FrameStatus.VALID]
        indices = np.linspace(0, len(frames) - 1, min(24, len(frames)), dtype=int)
        grouped[finger].append([frames[index] for index in indices])
    missing = [finger for finger, touches in grouped.items() if len(touches) < 3]
    if missing:
        raise SystemExit(
            f"session {args.session_id} lacks three trusted touches for: " +
            ", ".join(missing))

    enrollment = Path("/var/lib/open-fprintd/egis")
    atlas_root = Path("/var/lib/open-fprintd/egis-atlas")
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = enrollment.with_name(f"egis.pre-schema6.{stamp}")
    failed = enrollment.with_name(f"egis.failed-schema6.{stamp}")
    atlas_backup = atlas_root.with_name(f"egis-atlas.pre-schema6.{stamp}")
    atlas_failed = atlas_root.with_name(f"egis-atlas.failed-schema6.{stamp}")
    subprocess.run(["systemctl", "stop", "egis-bridge", "open-fprintd"], check=True)
    try:
        if enrollment.exists():
            os.replace(enrollment, backup)
        if atlas_root.exists():
            os.replace(atlas_root, atlas_backup)
        enrollment.mkdir(mode=0o700, parents=True)
        atlas_root.mkdir(mode=0o700, parents=True)
        matcher = ProductionMatcher(Persistence("/var/lib/open-fprintd"))
        for finger in FINGER_ORDER:
            if not matcher.enroll_finger(
                    f"{username}_{finger}", grouped[finger]):
                raise RuntimeError(f"failed to build production template for {finger}")
        print(f"Installed schema-5 templates for {username}: {', '.join(FINGER_ORDER)}")
        print(f"Previous templates: {backup}")
        if atlas_backup.exists():
            print(f"Previous touch atlases: {atlas_backup}")
    except BaseException:
        if enrollment.exists():
            os.replace(enrollment, failed)
        if backup.exists():
            os.replace(backup, enrollment)
        if atlas_root.exists():
            os.replace(atlas_root, atlas_failed)
        if atlas_backup.exists():
            os.replace(atlas_backup, atlas_root)
        raise
    finally:
        subprocess.run(["systemctl", "start", "open-fprintd", "egis-bridge"],
                       check=False)
    return 0


def cmd_analyze_sequence(args):
    source = Path(args.sequence).resolve()
    manifest, messages = load_sequence(source)
    valid = [message for message in messages if message.status.value == "valid"]
    if not valid:
        raise SystemExit("sequence contains no valid frames")
    spec = valid[0].frame_spec
    if any(message.frame_spec != spec for message in messages):
        raise SystemExit("sequence changes frame geometry")
    tracker = TouchTracker(spec)
    observations = []
    for message, boundary in sequence_events(messages):
        if boundary:
            tracker.discontinuity()
        if message.status.value != "valid":
            continue
        tracked = tracker.observe(message.pixels, sequence=message.sequence)
        registration = tracked.registration
        observations.append({
            "sequence": tracked.sequence,
            "quality": tracked.quality,
            "component": registration.component,
            "reference": registration.reference,
            "matches": registration.matches,
            "inliers": registration.inliers,
            "inlier_ratio": registration.inlier_ratio,
            "ridge_score": registration.ridge_score,
            "spatial_cells": registration.spatial_cells,
            "confidence": registration.confidence,
            "reason": registration.reason,
            "transform": registration.transform.tolist(),
        })

    output = Path(args.output or source / "analysis")
    output.mkdir(parents=True, mode=0o700, exist_ok=True)
    output.chmod(0o700)
    mosaics = {}
    for component, image in tracker.render_components().items():
        path = output / f"component-{component}.png"
        if not cv2.imwrite(str(path), image):
            raise SystemExit(f"failed to write {path}")
        path.chmod(0o600)
        mosaics[str(component)] = path.name
    report = {
        "schema_version": 1,
        "source": str(source),
        "source_complete": bool(manifest.get("complete")),
        "source_recorder_dropped": int(manifest.get("recorder_dropped", 0)),
        "frame_spec": {"width": spec.width, "height": spec.height,
                       "dtype": spec.dtype},
        "summary": tracker.summary(),
        "observations": observations,
        "mosaics": mosaics,
    }
    report_path = output / "report.json"
    report_path.write_text(
        json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    report_path.chmod(0o600)
    print(report_path)
    return 0


def _private_lab_path(value):
    path = Path(value).resolve()
    if not path.is_relative_to(LAB_ROOT.resolve()) or path == LAB_ROOT.resolve():
        raise ValueError("atlas artifacts and reports must stay under .egis-lab")
    LAB_ROOT.mkdir(mode=0o700, exist_ok=True)
    LAB_ROOT.chmod(0o700)
    return path


def cmd_enroll_sequences(args):
    output = _private_lab_path(args.output)
    atlas, sources = enroll_sequences(args.sequences, finger=args.finger)
    manifest = save_atlas(atlas, output, sources, finger=args.finger)
    print(json.dumps(manifest["summary"], indent=2, sort_keys=True))
    print(output)


def cmd_match_sequence(args):
    atlas, atlas_manifest = load_atlas(args.atlas)
    report = evaluate_sequence(atlas, atlas_manifest, args.sequence, args.expected)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    output = _private_lab_path(
        args.output or LAB_ROOT / "results" / f"sequence-{stamp}.json")
    output.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    write_private_json(output, report)
    print("Experimental spatial evidence; not a calibrated authentication result.")
    print(json.dumps({key: report[key] for key in (
        "candidate_match", "candidate_correct", "time_to_evidence_capture_ms",
        "processing_p95_ms", "source_complete", "atlas_finger", "probe_finger")},
        indent=2, sort_keys=True))
    print(output)


def _valid_sequence_frames(directory):
    directory = Path(directory)
    if not (directory / "manifest.json").is_file() or not (directory / "frames.bin").is_file():
        raise ValueError(
            f"sequence directory is missing manifest.json or frames.bin: {directory}"
        )
    manifest, messages, spec = read_touch(directory)
    frames = [message.pixels for message in messages
              if message.status is FrameStatus.VALID]
    # A sequence contains hundreds of near-identical sensor frames.  Keep a
    # deterministic spread for the expensive skeleton/minutiae extraction so
    # replay remains practical while retaining the full raw recording.
    limit = 24
    if len(frames) > limit:
        indices = np.linspace(0, len(frames) - 1, limit, dtype=int)
        frames = [frames[index] for index in indices]
    return manifest, spec, frames


def cmd_match_fingerprint_sequences(args):
    matcher = FingerprintMatcher()
    enrollment_frames = []
    enrollment_sources = []
    spec = None
    for directory in args.enrollment:
        manifest, current_spec, frames = _valid_sequence_frames(directory)
        if spec is not None and current_spec != spec:
            raise ValueError("enrollment sequences have different frame geometry")
        spec = current_spec
        enrollment_frames.extend(frames)
        enrollment_sources.append({
            "path": str(Path(directory).resolve()),
            "finger": manifest.get("metadata", {}).get("finger"),
            "frames": len(frames),
        })
    probe_manifest, probe_spec, probe_frames = _valid_sequence_frames(args.probe)
    if spec != probe_spec:
        raise ValueError("probe geometry differs from enrollment")
    template = matcher.build_template(enrollment_frames)
    result = matcher.match(probe_frames, template)
    report = {
        "schema_version": 1,
        "experimental": True,
        "promotable": False,
        "matcher_version": FINGERPRINT_MATCHER_VERSION,
        "candidate_match": result.matched,
        "score": result.score,
        "reason": result.reason,
        "metrics": result.metrics,
        "enrollment_sources": enrollment_sources,
        "probe": {
            "path": str(Path(args.probe).resolve()),
            "finger": probe_manifest.get("metadata", {}).get("finger"),
            "frames": len(probe_frames),
        },
    }
    output = _private_lab_path(args.output or LAB_ROOT / "results" /
                               f"fingerprint-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')}.json")
    output.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    write_private_json(output, report)
    print("Experimental ridge/minutiae evidence; not a calibrated authentication result.")
    print(json.dumps({key: report[key] for key in ("candidate_match", "score", "reason", "metrics")},
                     indent=2, sort_keys=True))
    print(output)


def cmd_match_touch_identity(args):
    atlas_root = _private_lab_path(args.atlas_root)
    atlases = {}
    for directory in sorted(atlas_root.iterdir()):
        if not directory.is_dir():
            continue
        atlas, manifest = load_atlas(directory)
        identity = manifest.get("finger") or directory.name
        atlases[identity] = atlas
    matcher = TouchIdentityMatcher(atlases)
    manifest, messages, _ = read_touch(args.sequence)
    updates = []
    decision = None
    started = time.perf_counter()
    for message, boundary in sequence_events(messages):
        if boundary:
            matcher.discontinuity()
        if message.status is not FrameStatus.VALID:
            continue
        decision = matcher.observe(message.pixels, message.sequence)
        updates.append({
            "sequence": message.sequence,
            "identity": decision.identity,
            "accepted": decision.accepted,
            "reason": decision.reason,
            "score": decision.score,
            "margin": decision.margin,
            "best_identity": decision.metrics["best_identity"],
            "supported_cells": decision.metrics["best"]["supported_cells"],
            "admitted_frames": decision.metrics["best"]["admitted_frames"],
        })
        if decision.accepted:
            break
    report = {
        "schema_version": 1,
        "experimental": True,
        "promotable": False,
        "probe_finger": manifest.get("metadata", {}).get("finger"),
        "accepted": bool(decision and decision.accepted),
        "identity": decision.identity if decision else None,
        "reason": decision.reason if decision else "no_valid_frames",
        "processing_ms": (time.perf_counter() - started) * 1000.0,
        "frames_processed": len(updates),
        "updates": updates,
    }
    output = _private_lab_path(args.output or LAB_ROOT / "results" /
                               f"touch-identity-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')}.json")
    output.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    write_private_json(output, report)
    print(json.dumps({key: report[key] for key in (
        "probe_finger", "accepted", "identity", "reason",
        "frames_processed", "processing_ms")}, indent=2, sort_keys=True))
    print(output)


def cmd_evaluate_nbis(args):
    sequence_root = LAB_ROOT / "sequences"
    selected = []
    development_sessions = {}
    for directory in sorted(sequence_root.iterdir()):
        manifest_path = directory / "manifest.json"
        if not manifest_path.is_file() or not os.access(manifest_path, os.R_OK):
            continue
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        metadata = manifest.get("metadata", {})
        if not manifest.get("complete") or manifest.get("recorder_dropped", 0):
            continue
        if (metadata.get("session_id") == args.session and
                metadata.get("role") == "enrollment" and
                metadata.get("finger") in FINGER_ORDER):
            selected.append(directory)
        if (args.include_development_probes and
                metadata.get("role") == "development" and
                metadata.get("finger") in ("right-pinky", "left-pinky")):
            development_sessions.setdefault(
                metadata.get("session_id"), []).append(directory)
    if args.include_development_probes and development_sessions:
        complete = [
            (session, paths) for session, paths in development_sessions.items()
            if {json.loads((path / "manifest.json").read_text())["metadata"]["finger"]
                for path in paths} == {"right-pinky", "left-pinky"}
        ]
        if complete:
            selected.extend(max(complete, key=lambda pair: pair[0])[1])
        else:
            raise ValueError("no complete two-pinky development session found")
    elif args.include_development_probes:
        raise ValueError("no readable pinky development sequences found")
    enrollment_counts = {
        finger: sum(json.loads((path / "manifest.json").read_text())["metadata"]["finger"] == finger
                    for path in selected)
        for finger in FINGER_ORDER
    }
    if any(count < 3 for count in enrollment_counts.values()):
        raise ValueError(
            "NBIS evaluation requires three clean enrollment touches per finger")
    output = _private_lab_path(args.output)
    output.mkdir(parents=True, mode=0o700, exist_ok=False)
    output.chmod(0o700)
    preprocessor = _load_preprocessor(args.calibration_profile)
    report = evaluate_nbis(selected, bin_dir=args.nbis_bin, preprocessor=preprocessor)
    write_private_json(output / "report.json", report)
    winner = report["winner"] or {}
    summary = {
        "gate_passed": report["gate_passed"],
        "sequence_count": report["sequence_count"],
        "winning_config": winner.get("config"),
        "extraction_success": winner.get("extraction_success"),
        "extraction_total": winner.get("extraction_total"),
        "genuine_correct": winner.get("genuine_correct"),
        "genuine_total": winner.get("genuine_total"),
        "minimum_genuine_score": winner.get("minimum_genuine_score"),
        "maximum_impostor_score": winner.get("maximum_impostor_score"),
        "score_gap": winner.get("score_gap"),
        "minimum_genuine_identity_margin": winner.get(
            "minimum_genuine_identity_margin"),
        "p95_extraction_ms": winner.get("p95_extraction_ms"),
        "p95_comparison_ms": winner.get("p95_comparison_ms"),
    }
    write_private_json(output / "summary.json", summary)
    print(json.dumps(summary, indent=2, sort_keys=True))
    print(output / "report.json")
    return 0 if report["gate_passed"] else 2


