#!/usr/bin/python3
import argparse
import dbus
import dbus.service
import dbus.mainloop.glib
import logging
from gi.repository import GLib

from egis_driver.services import EgisService

DEVICE_IFACE = 'io.github.uunicorn.Fprint.Device'
MANAGER_IFACE = 'net.reactivated.Fprint.Manager'
MANAGER_OBJ = '/net/reactivated/Fprint/Manager'
MANAGER_BUS = 'net.reactivated.Fprint'

logger = logging.getLogger("BRIDGE")


def configure_logging(debug=False):
    logging.basicConfig(
        level=logging.DEBUG if debug else logging.INFO,
        format='[%(name)s] %(message)s',
    )


class EgisBridge(dbus.service.Object):
    """Thin D-Bus adapter — delegates all business logic to EgisService."""

    def __init__(self, bus, service=None):
        self.bus = bus
        self.path = "/org/reactivated/Fprint/Device/Egis"
        dbus.service.Object.__init__(self, bus, self.path)

        self._service = service or EgisService(
            on_enroll_status=self._on_enroll_status,
            on_verify_status=self._on_verify_status,
            on_verify_finger_selected=self._on_verify_finger_selected,
        )

        self._register_with_manager()

    # ------------------------------------------------------------------
    #  D-Bus service registration
    # ------------------------------------------------------------------

    def _register_with_manager(self):
        try:
            manager_proxy = self.bus.get_object(MANAGER_BUS, MANAGER_OBJ)
            manager = dbus.Interface(manager_proxy, MANAGER_IFACE)
            manager.RegisterDevice(dbus.ObjectPath(self.path))
            logger.info("Successfully registered with open-fprintd!")
        except Exception as e:
            logger.error("Failed to register: %s", e)

    # ------------------------------------------------------------------
    #  Callback adapters: service callbacks -> D-Bus signals
    # ------------------------------------------------------------------

    def _on_enroll_status(self, result, done):
        GLib.idle_add(self.EnrollStatus, result, done)

    def _on_verify_status(self, result, done):
        GLib.idle_add(self.VerifyStatus, result, done)

    def _on_verify_finger_selected(self, finger):
        GLib.idle_add(self.VerifyFingerSelected, finger)

    # ------------------------------------------------------------------
    #  D-Bus methods
    # ------------------------------------------------------------------

    @dbus.service.method(DEVICE_IFACE, in_signature='ss', out_signature='')
    def VerifyStart(self, username, finger_name):
        logger.info("Verify requested for user: %s", username)
        self._service.start_verify(username, finger_name)

    @dbus.service.method(DEVICE_IFACE, in_signature='', out_signature='')
    def VerifyStop(self):
        logger.info("Verify stopped")
        self._service.cancel()

    @dbus.service.method(DEVICE_IFACE, in_signature='ss', out_signature='')
    def EnrollStart(self, username, finger_name):
        logger.info("Enroll requested for user: %s", username)
        self._service.start_enroll(username, finger_name)

    @dbus.service.method(DEVICE_IFACE, in_signature='', out_signature='')
    def EnrollStop(self):
        logger.info("Enroll stopped")
        self._service.cancel()

    @dbus.service.method(DEVICE_IFACE, in_signature='', out_signature='')
    def Cancel(self):
        logger.info("Cancel requested")
        self._service.cancel()

    @dbus.service.method(DEVICE_IFACE, in_signature='', out_signature='')
    def Suspend(self):
        logger.info("Suspend requested")
        self._service.suspend()

    @dbus.service.method(DEVICE_IFACE, in_signature='', out_signature='')
    def Resume(self):
        logger.info("Resume requested")
        self._service.resume()

    @dbus.service.method(DEVICE_IFACE, in_signature='s', out_signature='as')
    def ListEnrolledFingers(self, username):
        fingers = self._service.list_enrolled_fingers(username)
        logger.info("Listing fingers for %s: %s", username, fingers)
        return fingers

    @dbus.service.method(DEVICE_IFACE, in_signature='s', out_signature='')
    def DeleteEnrolledFingers(self, username):
        logger.info("Deleting prints for %s", username)
        self._service.delete_enrolled_fingers(username)

    # ------------------------------------------------------------------
    #  D-Bus signals
    # ------------------------------------------------------------------

    @dbus.service.signal(DEVICE_IFACE, signature='sb')
    def VerifyStatus(self, result, done):
        pass

    @dbus.service.signal(DEVICE_IFACE, signature='s')
    def VerifyFingerSelected(self, finger):
        pass

    @dbus.service.signal(DEVICE_IFACE, signature='sb')
    def EnrollStatus(self, result, done):
        pass


if __name__ == '__main__':
    parser = argparse.ArgumentParser('Egis EH575 D-Bus bridge')
    parser.add_argument('--debug', help='Enable debug logging', action='store_true')
    args = parser.parse_args()
    configure_logging(args.debug)

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    name = dbus.service.BusName("io.github.uunicorn.Fprint.Device.Egis", bus)
    device = EgisBridge(bus)
    loop = GLib.MainLoop()
    loop.run()
